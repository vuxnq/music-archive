@model MusicArchive.Domain.Models.Track

@{
    ViewBag.Title = Model.Title;
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>

<div>
    <h3>details</h3>
    <p>Id: @Model.Id</p>
    <p>Title: @Model.Title</p>
    <p>Description: @Model.Description</p>
    <p>Duration: @Model.Duration</p>
    <p>Release id: @Model.ReleaseId</p>
</div>

@if (Model.Release != null) {
    <h3>Release</h3>
    <p>
        @Html.ActionLink(Model.Release.Title, "Detail", "Release", new { id = Model.Release.Id }, null)
    </p>
}

@if (!Model.IsApproved && User?.Identity?.IsAuthenticated == true && User.IsInRole("Moderator")) {
    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" style="display:inline">
        <button type="submit" class="btn btn-success">Approve</button>
    </form>
    <form asp-action="Reject" asp-route-id="@Model.Id" method="post" style="display:inline" onsubmit="return confirm('Are you sure you want to reject this track?');">
        <button type="submit" class="btn btn-danger">Reject</button>
    </form>
}
