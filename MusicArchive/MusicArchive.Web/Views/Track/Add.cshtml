@model TrackAddDto

@{
    ViewBag.Title = "Add Track";
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("Add", "Track", FormMethod.Post)) {
    @Html.AntiForgeryToken()
    <div>
        <label for="Title">Title</label>
        <input type="text" id="Title" name="Title" value="@Model?.Title" required />
    </div>
    <div>
        <label for="Description">Description</label>
        <input type="text" id="Description" name="Description" value="@Model?.Description" />
    </div>
    <div>
        <label for="Duration">Duration (seconds)</label>
        <input type="number" id="Duration" name="Duration" value="@(Model?.Duration.ToString() ?? string.Empty)" required />
    </div>
    <div>
        <label for="ReleaseId">Release Id</label>
        <select id="ReleaseId" asp-for="ReleaseId" asp-items="Model.ReleaseOptions" required="required">
            <option value="" selected="selected" disabled="disabled">Select Release</option>
        </select>
    </div>
    <div>
        <button type="submit">Submit</button>
    </div>
}
