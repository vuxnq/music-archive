@model HomeIndexDto

@{
    ViewBag.Title = "Home Page";
    Layout = "_Layout";
}

<div>
    <div>
        <h2>Artists</h2>
        @Html.ActionLink("All", "Index", "Artist", null, null)
        <ul>
            @foreach (var artist in Model.Artists) {
                <li>
                    @Html.ActionLink(artist.Name, "Detail", "Artist", new { id = artist.Id }, null)
                </li>
            }
        </ul>
    </div>

    <div>
        <h2>Releases</h2>
        @Html.ActionLink("All", "Index", "Release", null, null)
        <ul>
            @foreach (var release in Model.Releases) {
                <li>
                    @Html.ActionLink(release.Title, "Detail", "Release", new { id = release.Id }, null)
                </li>
            }
        </ul>
    </div>
</div>

<div>
    <h2>Genres</h2>
    <ul>
        @foreach (var genre in Model.Genres) {
            <li>
                @Html.ActionLink(genre.Name, "Detail", "Genre", new { id = genre.Id }, null)
            </li>
        }
    </ul>
</div>
