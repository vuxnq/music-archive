@model List<MusicArchive.Domain.Models.Artist>

@{
    ViewBag.Title = "Home Page";
    Layout = "_Layout";
}

<div class="artist-list">
    <h2>Artists</h2>
    <ul class="list-group">
        @foreach (var artist in Model) {
            <li class="list-group-item">
                @Html.ActionLink(artist.Name, "Detail", "Artist", new { id = artist.Id }, null)
            </li>
        }
    </ul>
</div>