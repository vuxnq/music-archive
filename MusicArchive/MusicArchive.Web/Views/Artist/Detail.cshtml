@model MusicArchive.Domain.Models.Artist

@{
    ViewBag.Title = Model.Name;
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>

<div>
    <h3>details</h3>
    <p>Id: @Model.Id</p>
    <p>Name: @Model.Name</p>
    <p>Description: @Model.Description</p>
    <p>Begin date: @Model.BeginDate.ToString("d")</p>
    <p>End date: @(Model.EndDate?.ToString("d") ?? "")</p>
    <p>Location: @Model.Location</p>
</div>

<div>
    <h3>Releases</h3>
    @if (Model.Releases.Any()) {
        <ul>
            @foreach (var r in Model.Releases) {
                <li>
                    @Html.ActionLink(r.Title, "Detail", "Release", new { id = r.Id }, null)
                    @* @(r.ReleaseDate.ToString("d")) *@
                </li>
            }
        </ul>
    } else {
        <p>no releases</p>
    }
    <form asp-controller="Release" asp-action="Add" method="get">
        <input type="hidden" name="artistsId" value="@Model.Id" />
        <button type="submit" class="btn btn-primary">Add Release</button>
    </form>
</div>

@if (!Model.IsApproved && User?.Identity?.IsAuthenticated == true && User.IsInRole("Moderator")) {
    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" style="display:inline">
        <button type="submit" class="btn btn-success">Approve</button>
    </form>
    <form asp-action="Reject" asp-route-id="@Model.Id" method="post" style="display:inline" onsubmit="return confirm('Are you sure you want to reject this artist?');">
        <button type="submit" class="btn btn-danger">Reject</button>
    </form>
}
