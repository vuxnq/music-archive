<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div style="width: 100%; max-width: 400px;">

        <div class="card shadow-sm border">
            <div class="card-body p-4">
                <h3 class="text-center mb-4 fw-bold">Create Account</h3>

                <form asp-action="Join" method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" type="password" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="RepeatPassword" class="form-label">Password Again</label>
                        <input asp-for="RepeatPassword" class="form-control" type="password" required />
                    </div>

                    <button type="submit" class="btn btn-dark w-100">Join</button>
                </form>
            </div>
        </div>

        <div class="text-center mt-3">
            <p class="text-muted">
                Already have an account?
                <a href="@Url.Action("Login", "User")" class="text-decoration-none fw-bold">Login here</a>
            </p>
        </div>

    </div>
</div>
