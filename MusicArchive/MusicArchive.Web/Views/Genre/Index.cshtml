@model List<MusicArchive.Domain.Models.Genre>

@{
    ViewBag.Title = "Genres";
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>
<ul>
@foreach (var genre in Model) {
    <li>
        @Html.ActionLink(genre.Name, "Detail", "Genre", new { id = genre.Id }, null)
    </li>
}
</ul>

@using (Html.BeginForm("Index", "Genre", FormMethod.Post)) {
    @Html.AntiForgeryToken()
    <div>
        <label for="Name">Name</label>
        <input type="text" id="Name" name="Name" required />
    </div>
    <div>
        <button type="submit">Add Genre</button>
    </div>
}