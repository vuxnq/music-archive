@model List<MusicArchive.Domain.Models.Genre>

@{
    ViewBag.Title = "Genres";
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>
<ul>
@foreach (var genre in Model) {
    <li>
        @Html.ActionLink(genre.Name, "Detail", "Genre", new { id = genre.Id }, null)
    </li>
}
</ul>
<p>
    @Html.ActionLink("Add new genre", "Add", "Genre")
</p>