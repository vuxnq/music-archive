@model MusicArchive.Web.Models.GenreAddDto

@{
    ViewBag.Title = "Add Genre";
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("Add", "Genre", FormMethod.Post)) {
    @Html.AntiForgeryToken()
    <div>
        <label for="Name">Name</label>
        <input type="text" id="Name" name="Name" value="@Model?.Name" required />
    </div>
    <div>
        <button type="submit">Add Genre</button>
    </div>
}
