@model DashboardIndexDto

@{
    ViewBag.Title = "Dashboard";
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>

<div>
    <h3>Artist Submissions</h3>
    <ul>
        @foreach (var artist in Model.Artists) {
            <li>
                @Html.ActionLink(artist.Name, "Detail", "Artist", new { id = artist.Id }, null)
            </li>
        }
    </ul>

    <h3>Release Submissions</h3>
    <ul>
        @foreach (var release in Model.Releases) {
            <li>
                @Html.ActionLink(release.Title, "Detail", "Release", new { id = release.Id }, null)
            </li>
        }
    </ul>

    <h3>Track Submissions</h3>
    <ul>
        @foreach (var track in Model.Tracks) {
            <li>
                @Html.ActionLink(track.Title, "Detail", "Track", new { id = track.Id }, null)
            </li>
        }
    </ul>
</div>

<div>
    <h3>Genre Submissions</h3>
    <ul>
        @foreach (var genre in Model.Genres) {
            <li>
                @Html.ActionLink(genre.Name, "Detail", "Genre", new { id = genre.Id }, null)
            </li>
        }
    </ul>
</div>
