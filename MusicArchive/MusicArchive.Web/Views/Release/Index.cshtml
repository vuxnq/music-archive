@model List<MusicArchive.Domain.Models.Release>

@{
    ViewBag.Title = "Releases";
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>
@Html.ActionLink("Propose New Release", "Add", "Release")
<ul>
    @foreach (var release in Model) {
        <li>
            @Html.ActionLink(release.Title, "Detail", "Release", new { id = release.Id }, null)
        </li>
    }
</ul>
