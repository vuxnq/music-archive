@model MusicArchive.Domain.Models.Release

@{
    ViewBag.Title = Model.Title;
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>

<div>
    <h3>details</h3>
    <p>Id: @Model.Id</p>
    <p>Name: @Model.Title</p>
    <p>Description: @Model.Description</p>
    <p>Release date: @(Model.ReleaseDate.ToString("d"))</p>
    <p>Artist id: @Model.ArtistsId</p>
    <p>Genre id: @Model.GenreId</p>
</div>

<h3>Artist</h3>
<p>@Model.Artist.Name</p>
<p>@Model.Artist.BeginDate</p>

@if (Model.Genre != null) {
    <h3>Genre</h3>
    <p>@Model.Genre.Name</p>
}

<h3>Tracks</h3>
<ul>
    @foreach (var track in Model.Tracks) {
        <li>
            @Html.ActionLink(track.Title, "Detail", "Track", new { id = track.Id }, null)
        </li>
    }
</ul>
<form asp-controller="Track" asp-action="Add" method="get">
    <input type="hidden" name="ReleaseId" value="@Model.Id" />
    <button type="submit" class="btn btn-primary">Add Track</button>
</form>

@if (!Model.IsApproved && User?.Identity?.IsAuthenticated == true && User.IsInRole("Moderator")) {
    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" style="display:inline">
        <button type="submit" class="btn btn-success">Approve</button>
    </form>
    <form asp-action="Reject" asp-route-id="@Model.Id" method="post" style="display:inline" onsubmit="return confirm('Are you sure you want to reject this release?');">
        <button type="submit" class="btn btn-danger">Reject</button>
    </form>
}
